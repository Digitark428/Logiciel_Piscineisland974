# =========================================================================
# LETI — Variables d'environnement (NE JAMAIS committer de secrets)
# Copier vers .env.local et renseigner les vraies valeurs.
# =========================================================================

# --- Supabase (public : exposé au client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET : serveur uniquement, jamais côté client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Super Admin (bootstrap du propriétaire de la plateforme) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Sécurité CRON (sauvegardes automatiques 23h00) ---
CRON_SECRET=

# --- Sécurité portail (SECRET dédié, requis en production) ---
PORTAL_SESSION_SECRET=

# --- (Réservé évolutions — NON utilisé en V1) ---
# RESEND_API_KEY=   # Resend n'est PAS intégré dans cette version.
